<?xml version="1.0" encoding="utf-8"?>
<!--
  Azure App Service (Windows) web.config for Node.js + SSE
  ──────────────────────────────────────────────────────────
  Key settings that make Server-Sent Events work on Azure:

  1. iisnode handler routes all traffic to server.js via Node.js
  2. responseBufferLimit="0" disables IIS response buffering — without
     this, IIS holds SSE chunks until the buffer fills and NEVER flushes
     them to the browser, breaking real-time events completely.
  3. flushResponse="true" forces IIS to forward each write() call
     immediately instead of waiting for the response to finish.
  4. X-Accel-Buffering: no header (set in the /events route) tells any
     upstream Nginx/CDN proxy not to buffer either.
  5. The rewrite rules proxy everything to the Node process.
-->
<configuration>
  <system.webServer>

    <!-- ── iisnode: runs server.js under Node.js ── -->
    <iisnode
      nodeProcessCommandLine="node"
      watchedFiles="web.config;*.js"
      loggingEnabled="true"
      logDirectory="iisnode"
      debuggingEnabled="false"
      responseBufferLimit="0"
      flushResponse="true"
    />

    <!-- ── URL rewrite: send everything to the Node process ── -->
    <rewrite>
      <rules>
        <!-- Don't rewrite iisnode internal paths -->
        <rule name="NodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^server.js\/debug[\/]?" />
        </rule>

        <!-- Route all requests to server.js -->
        <rule name="StaticContent" stopProcessing="true">
          <action type="Rewrite" url="server.js"/>
        </rule>
      </rules>
    </rewrite>

    <!-- ── Security: hide the server header ── -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules"/>
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- ── Default document ── -->
    <defaultDocument enabled="false"/>

    <!-- ── Increase idle timeout for long-lived SSE connections ── -->
    <!--
      Azure App Service's ARR (Application Request Routing) proxy has a
      default idle timeout of 240 seconds. We send a :ping comment every
      25 seconds from the /events route, which resets this timer.
      The setting below increases the IIS request timeout to 10 minutes
      so IIS itself does not close the SSE connection before ARR does.
    -->
    <httpRuntime executionTimeout="600"/>

  </system.webServer>
</configuration>
